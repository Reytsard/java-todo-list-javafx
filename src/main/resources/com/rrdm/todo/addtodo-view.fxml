<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rrdm.todo.AddTodoController">
   <children>
      <Label alignment="CENTER" prefHeight="17.0" prefWidth="443.0" text="Title:">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <TextField fx:id="titleField" prefHeight="40.0" prefWidth="400.0" />
      <Label alignment="BOTTOM_CENTER" prefHeight="50.0" prefWidth="400.0" text="Description:">
         <font>
            <Font size="27.0" />
         </font>
      </Label>
      <TextArea fx:id="descField" prefHeight="108.0" prefWidth="400.0" />
      <Label prefHeight="34.0" prefWidth="400.0" text="Priority:">
         <font>
            <Font size="17.0" />
         </font>
         <VBox.margin>
            <Insets left="5.0" right="5.0" />
         </VBox.margin>
      </Label>
      <ComboBox fx:id="priorityComboBox" prefHeight="25.0" prefWidth="416.0" promptText="Select Priority">
         <VBox.margin>
            <Insets left="5.0" right="5.0" />
         </VBox.margin>
      </ComboBox>
      <Button fx:id="addTodoButton" mnemonicParsing="false" onAction="#onAddTodoButtonClick" prefHeight="40.0" prefWidth="400.0" text="Add Todo">
         <VBox.margin>
            <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
         </VBox.margin>
      </Button>
      <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#onCancelButtonClick" prefHeight="40.0" prefWidth="400.0" text="Cancel">
         <VBox.margin>
            <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin>
      </Button>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
