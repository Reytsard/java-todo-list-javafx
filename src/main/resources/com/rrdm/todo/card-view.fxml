<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootNode" prefHeight="250.0" prefWidth="225.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rrdm.todo.CardController">
   <children>
      <Button fx:id="leftMoveButton" layoutX="15.0" layoutY="14.0" mnemonicParsing="false" onAction="#moveLeftButtonClick" prefHeight="25.0" prefWidth="31.0" text="&lt;-" />
      <Button fx:id="rightMoveButton" layoutX="174.0" layoutY="14.0" mnemonicParsing="false" onAction="#moveRightButtonClick" prefHeight="25.0" prefWidth="31.0" text="-&gt;" />
      <Label fx:id="titleLabel" alignment="TOP_CENTER" layoutX="22.0" layoutY="46.0" prefHeight="47.0" prefWidth="182.0" text="Title Label" wrapText="true">
         <font>
            <Font name="Verdana Bold" size="18.0" />
         </font>
      </Label>
      <Label fx:id="descLabel" alignment="TOP_LEFT" layoutX="13.0" layoutY="106.0" prefHeight="94.0" prefWidth="200.0" text="Label" wrapText="true">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="editButton" layoutX="84.0" layoutY="211.0" mnemonicParsing="false" onAction="#onEditButtonClick" prefHeight="25.0" prefWidth="58.0" text="Edit" />
   </children>
</AnchorPane>
