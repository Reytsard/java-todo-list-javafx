<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rrdm.todo.EditCardController">
   <children>
      <Label layoutX="33.0" layoutY="14.0" text="Title:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextField fx:id="titleField" layoutX="35.0" layoutY="41.0" prefHeight="45.0" prefWidth="333.0" />
      <Label layoutX="34.0" layoutY="103.0" text="Description:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <TextArea fx:id="descriptionField" layoutX="33.0" layoutY="130.0" prefHeight="116.0" prefWidth="333.0" />
      <ComboBox fx:id="prioComboBox" layoutX="35.0" layoutY="285.0" prefHeight="37.0" prefWidth="333.0" />
      <Label layoutX="34.0" layoutY="258.0" text="Priority:">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="saveButton" layoutX="204.0" layoutY="349.0" mnemonicParsing="false" onAction="#onSaveButtonClick" prefHeight="37.0" prefWidth="161.0" text="Save" />
      <Button fx:id="cancelButton" layoutX="34.0" layoutY="349.0" mnemonicParsing="false" onAction="#onCancelButtonClick" prefHeight="37.0" prefWidth="161.0" text="Cancel" />
   </children>
</AnchorPane>
